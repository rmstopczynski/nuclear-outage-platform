@model List<MVC_EF_Start_8.Models.OutageRecord>
@{
    ViewData["Title"] = "Data Visualization";
    Layout = "_Layout";
}

<section class="intro">
    <h2>@ViewData["Title"]</h2>
    <p>
        Trends across the last 30 days of ingested outage data. Click a day, a
        facility bar, or a region bar to filter the other two charts &mdash;
        click the same one again to clear it.
    </p>
</section>

<div id="chart-filters" class="chart-filters"></div>

<div class="chart-container">
    <h3>Daily Nuclear Outage (Last 30 Days, MW)</h3>
    <div class="chart-canvas-wrap">
        <canvas id="lineChart"></canvas>
    </div>
    <p class="chart-hint">Click a point to filter by day</p>
</div>

<div class="chart-row">
    <div class="chart-container">
        <h3>Top Facilities by Outage (MW)</h3>
        <div class="chart-canvas-wrap chart-canvas-wrap--tall">
            <canvas id="facilityChart"></canvas>
        </div>
        <p class="chart-hint">Click a bar to filter by facility</p>
    </div>
    <div class="chart-container">
        <h3>Outage by Region (MW)</h3>
        <div class="chart-canvas-wrap chart-canvas-wrap--tall">
            <canvas id="regionChart"></canvas>
        </div>
        <p class="chart-hint">Click a bar to filter by region</p>
    </div>
</div>

<div class="panel ai-summary-card">
    <h3>AI Outage Summary <span class="ai-summary-badge">beta</span></h3>
    <p class="ai-summary-hint">
        A short, plain-English summary of recent outage activity, generated
        on demand from the same data shown above (last 7 days by default).
    </p>
    <button id="ai-summary-btn" type="button" class="btn btn-primary">Generate Summary</button>
    <div id="ai-summary-result" class="ai-summary-result" style="display: none;"></div>
</div>

@section Styles {
    <style>
        .chart-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }
        .chart-row .chart-container {
            flex: 1;
            min-width: 300px;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.getElementById('ai-summary-btn').addEventListener('click', function () {
            const btn = this;
            const resultBox = document.getElementById('ai-summary-result');

            btn.disabled = true;
            btn.textContent = 'Generating...';
            resultBox.style.display = 'block';
            resultBox.classList.remove('error');
            resultBox.textContent = 'Asking the AI summary endpoint for recent outage activity...';

            fetch('/api/outages/summary')
                .then(async (response) => {
                    if (!response.ok) {
                        const problem = await response.json().catch(() => null);
                        const message = problem?.detail || problem?.title || `Request failed (${response.status}).`;
                        throw new Error(message);
                    }
                    return response.json();
                })
                .then((data) => {
                    resultBox.textContent = data.summary;
                })
                .catch((error) => {
                    resultBox.classList.add('error');
                    resultBox.textContent = `Couldn't generate a summary: ${error.message}`;
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.textContent = 'Generate Summary';
                });
        });
    </script>
}
