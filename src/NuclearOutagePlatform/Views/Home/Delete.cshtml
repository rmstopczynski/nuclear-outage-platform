@model MVC_EF_Start_8.Models.OutageRecord

@{
    ViewData["Title"] = "Delete";
    Layout = "_Layout";
}

<h2>Confirm Deletion</h2>

<div class="panel form-card">
    <p>
        Are you sure you want to delete the <span class="mono">@Model.Period</span> outage
        record for facility <strong class="mono">@Model.Facility</strong> (@Model.FacilityName)?
        This can't be undone.
    </p>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="action-row">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-action="Read" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
