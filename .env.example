# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real credentials.

# Get a free API key at https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here

# How often the background service re-fetches from EIA. Optional --
# defaults to 6 if not set.
EIA_INGESTION_INTERVAL_HOURS=6

# JWT signing key for login/auth (Step 3). Any long random string works --
# generate one locally, e.g.: openssl rand -base64 48
# Must be kept secret in any real deployment; this is a throwaway local
# value, same category as the Postgres credentials below.
JWT_KEY=replace_with_a_long_random_string_at_least_32_chars

# Groq API key for the AI outage summary feature (Step 5). Groq's API is
# OpenAI-compatible and has a genuinely free tier (no credit card) --
# generous enough for a portfolio project. Get a key at
# https://console.groq.com/keys
# Optional -- if left blank, GET /api/outages/summary returns a 503
# explaining the feature isn't configured, rather than the app failing to
# start (this is a bonus feature, not a required dependency).
GROQ_API_KEY=

# Local Postgres credentials (fine to leave as defaults for local dev --
# this is a throwaway local database, not a real production credential)
POSTGRES_USER=outages
POSTGRES_PASSWORD=outages
POSTGRES_DB=outages_db

ASPNETCORE_ENVIRONMENT=Development
